{
  "name": "@ai-sdk-letta/example-basic",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal ai-sdk-letta agent with one custom tool, run in the terminal or the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "tui": "node --conditions=ai-sdk-letta-source --import tsx src/tui.ts",
    "gui": "npm run build --workspace @ai-sdk-letta/web && node --conditions=ai-sdk-letta-source --import tsx src/gui.ts",
    "tokens": "node --conditions=ai-sdk-letta-source --import tsx src/tokens.ts"
  },
  "dependencies": {
    "@ai-sdk-letta/server": "*",
    "@ai-sdk-letta/tui": "*",
    "@ai-sdk-letta/web": "*",
    "@ai-sdk/harness": "1.0.128",
    "@ai-sdk/mcp": "2.0.60",
    "@lgrammel/apple-container-sandbox": "1.1.0",
    "ai": "7.0.118",
    "ai-sdk-letta": "*",
    "ai-sdk-sandbox-docker": "0.1.2"
  }
}
