{
  "name": "ai_sdk_letta_run_turn_worker",
  "version": 1,
  "description": "Run one turn of an ai-sdk-letta agent with the ai_sdk_letta_turn worker (src/conductor-worker.ts), which waits for long turns without polling every minute. Fails with approval_required / question_required when the turn needed a person.",
  "schemaVersion": 2,
  "ownerEmail": "ai-sdk-letta@example.invalid",
  "inputParameters": [
    "text",
    "title"
  ],
  "timeoutSeconds": 1800,
  "timeoutPolicy": "TIME_OUT_WF",
  "tasks": [
    {
      "name": "ai_sdk_letta_turn",
      "taskReferenceName": "turn",
      "type": "SIMPLE",
      "inputParameters": {
        "text": "${workflow.input.text}",
        "title": "${workflow.input.title}"
      }
    }
  ],
  "outputParameters": {
    "runId": "${turn.output.id}",
    "reply": "${turn.output.text}",
    "conversation": "${turn.output.conversation}",
    "tools": "${turn.output.tools}",
    "files": "${turn.output.files}"
  }
}
