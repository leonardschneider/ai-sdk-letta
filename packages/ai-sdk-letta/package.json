{
  "name": "ai-sdk-letta",
  "version": "0.1.0",
  "description": "A persistent, Letta-backed Vercel AI SDK Agent with memory, dreaming, application-owned tools and human-in-the-loop.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/leonardschneider/ai-sdk-letta.git", "directory": "packages/ai-sdk-letta" },
  "keywords": ["ai", "ai-sdk", "vercel", "letta", "agent", "memory"],
  "engines": { "node": ">=22.19.0" },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "ai-sdk-letta-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --conditions=ai-sdk-letta-source --import tsx --test test/*.test.ts",
    "test:live": "node --conditions=ai-sdk-letta-source --import tsx --test --test-concurrency=1 test/live/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.18",
    "@letta-ai/letta-agent-sdk": "0.8.22",
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "ai": "7.0.118"
  },
  "devDependencies": {
    "ai": "7.0.118"
  }
}
