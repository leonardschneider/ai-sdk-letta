{
  "name": "@ai-sdk-letta/provider",
  "version": "2.0.0",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest --config vitest.node.config.mjs --run",
    "test:e2e": "vitest --config vitest.e2e.config.mjs --run",
    "test:e2e:local": "vitest --config vitest.e2e.local.config.mjs --run",
    "test:node": "vitest --config vitest.node.config.mjs --run",
    "test:node:watch": "vitest --config vitest.node.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^2.0.0",
    "@ai-sdk/provider-utils": "^3.0.16",
    "@letta-ai/letta-agent-sdk": "0.8.22"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.0",
    "tsup": "^8",
    "typescript": "5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.1.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "ai": "7.0.118"
  },
  "peerDependencies": {
    "ai": "^7.0.84",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://github.com/leonardschneider/ai-sdk-letta/tree/main/packages/provider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardschneider/ai-sdk-letta.git",
    "directory": "packages/provider"
  },
  "bugs": {
    "url": "https://github.com/leonardschneider/ai-sdk-letta/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "letta"
  ],
  "description": "Vercel AI SDK LanguageModel for Letta agents over the Letta Agent SDK. Unofficial port of letta-ai/vercel-ai-sdk-provider."
}
