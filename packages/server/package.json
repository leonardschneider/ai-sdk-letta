{
  "name": "@ai-sdk-letta/server",
  "version": "0.1.0",
  "description": "Local HTTP runtime for ai-sdk-letta agents: durable threads and runs, NDJSON events, a token API and a loopback browser app.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/leonardschneider/ai-sdk-letta.git", "directory": "packages/server" },
  "engines": { "node": ">=22.19.0" },
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "ai-sdk-letta-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --conditions=ai-sdk-letta-source --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ai-sdk-letta": "0.1.0",
    "express": "5.2.1"
  },
  "peerDependencies": {
    "ai": "7.0.118"
  },
  "devDependencies": {
    "@letta-ai/letta-agent-sdk": "0.8.22",
    "@types/express": "5.0.6",
    "ai": "7.0.118"
  }
}
